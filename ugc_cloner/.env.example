# UGC Cloner — Environment Variables (Optional)
# Copy this to .env and fill in your credentials
# Or add these to config/settings.yaml directly

# ─── Amazon Affiliate ────────────────────────────────────────
AMAZON_PARTNER_TAG=your_associates_tag-20
AMAZON_ACCESS_KEY=your_aws_access_key
AMAZON_SECRET_KEY=your_aws_secret_key
AMAZON_MIN_COMMISSION=3.0

# ─── TikTok API ──────────────────────────────────────────────
TIKTOK_CLIENT_KEY=your_client_key
TIKTOK_CLIENT_SECRET=your_client_secret
TIKTOK_ACCESS_TOKEN=your_access_token

# ─── Instagram ───────────────────────────────────────────────
INSTAGRAM_USERNAME=your_username
INSTAGRAM_PASSWORD=your_password
INSTAGRAM_ACCESS_TOKEN=your_graph_api_token

# ─── YouTube ─────────────────────────────────────────────────
YOUTUBE_CREDENTIALS_FILE=config/youtube_credentials.json

# ─── Content Generation ──────────────────────────────────────
BATCH_SIZE=250
VIDEO_SPLIT=0.6
TTS_ENGINE=gtts
TTS_SPEED=1.15

# ─── Scheduler ───────────────────────────────────────────────
POSTS_PER_DAY=4
CAMPAIGN_DAYS=60
TIMEZONE=America/New_York
